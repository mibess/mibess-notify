# Local development only; never commit real values.
DB_HOST=localhost
DB_PORT=55432
DB_NAME=mibess_notify
DB_USERNAME=notify
DB_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=55672
RABBITMQ_USER=notify
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/mibess-notify
MASTER_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@mibess.com.br
ADMIN_PASSWORD=
COOKIE_SECURE=false
NOTIFY_ENV=dev
FAKE_PROVIDER_ENABLED=true
META_GRAPH_VERSION=v26.0
OPENAPI_ENABLED=true
EVENTS_PER_MINUTE=120
RETRY_DELAYS_SECONDS=60,300,900,3600

# Notification identities: private S3, credentials only in the backend.
NOTIFY_IMAGES_BUCKET=
AWS_REGION=sa-east-1
NOTIFY_IMAGES_PREFIX=mibess-notify/dev
NOTIFY_IMAGES_WIDTH=960
NOTIFY_IMAGES_HEIGHT=320
NOTIFY_IMAGES_MAX_BYTES=500000
# In AWS prefer a workload role. On the VPS, use dedicated scoped credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
